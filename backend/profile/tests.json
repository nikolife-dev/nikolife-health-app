{
  "tests": [
    {
      "name": "Get profile without token",
      "method": "GET",
      "path": "/",
      "expectedStatus": 401,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Update profile without token",
      "method": "PUT",
      "path": "/",
      "body": {
        "name": "Test User",
        "email": "test@example.com"
      },
      "expectedStatus": 401,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Link telegram without token",
      "method": "POST",
      "path": "/?action=link_telegram",
      "body": {
        "id": 123
      },
      "expectedStatus": 401,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    }
  ]
}